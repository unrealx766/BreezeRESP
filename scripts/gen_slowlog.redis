-- 1. 创建一个大 Hash (10000 个字段)
DEL slowlog:big_hash
EVAL "for i=1,10000 do redis.call('HSET','slowlog:big_hash','field:'..i,'value:'..string.rep('x',100)) end return 1" 0

-- 2. 创建一个大 List (5000 个元素)
DEL slowlog:big_list
EVAL "for i=1,5000 do redis.call('RPUSH','slowlog:big_list','item:'..i..':'..string.rep('data',50)) end return 1" 0

-- 3. 创建一个大 Set (8000 个成员)
DEL slowlog:big_set
EVAL "for i=1,8000 do redis.call('SADD','slowlog:big_set','member:'..i..':'..string.rep('v',30)) end return 1" 0

-- 4. 创建一个大 ZSet (8000 个成员)
DEL slowlog:big_zset
EVAL "for i=1,8000 do redis.call('ZADD','slowlog:big_zset',i,'zmember:'..i..':'..string.rep('s',30)) end return 1" 0

-- 5. 创建大量小 key (用于 KEYS * 慢查询)
EVAL "for i=1,3000 do redis.call('SET','slowlog:key:'..i,'val:'..string.rep('a',200)) end return 1" 0

-- 6. 触发慢查询: KEYS * (扫描全部 key)
KEYS slowlog:*

-- 7. 触发慢查询: SORT 大 List
SORT slowlog:big_list ALPHA

-- 8. 触发慢查询: HGETALL 大 Hash
HGETALL slowlog:big_hash

-- 9. 触发慢查询: SMEMBERS 大 Set
SMEMBERS slowlog:big_set

-- 10. 触发慢查询: ZRANGE 大 ZSet
ZRANGE slowlog:big_zset 0 -1 WITHSCORES

-- 11. 触发慢查询: LRANGE 大 List 全范围
LRANGE slowlog:big_list 0 -1

-- 12. 触发慢查询: 大 key 的 DEL
DEL slowlog:big_hash slowlog:big_list slowlog:big_set slowlog:big_zset

-- 13. 再次创建并删除 (产生更多慢查询)
EVAL "for i=1,5000 do redis.call('HSET','slowlog:temp_hash','f:'..i,'v:'..string.rep('y',80)) end return 1" 0
DEL slowlog:temp_hash

-- 14. 清理所有 slowlog: 前缀的 key
EVAL "local keys = redis.call('KEYS','slowlog:*'); for _,k in ipairs(keys) do redis.call('DEL',k) end return #keys" 0

-- 15. 查看慢日志长度
SLOWLOG LEN
